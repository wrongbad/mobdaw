{
  "name": "mobdaw",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @mobdaw/server\" \"npm run dev -w @mobdaw/client --if-present\"",
    "build": "npm run build -w @mobdaw/client --if-present",
    "test": "npm test -w @mobdaw/server && npm test -w @mobdaw/client --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "admin": "npm run admin -w @mobdaw/server --"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
