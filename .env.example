# Copy to .env (repo root). All values optional in dev.
PORT=8787
PUBLIC_URL=http://localhost:5173
# Set a fixed secret in dev too, or everyone is logged out on each server restart.
SESSION_SECRET=dev-secret-change-me
DB_PATH=./data/mobdaw.db
STORAGE_DRIVER=local          # local | s3
STORAGE_DIR=./data/samples
# S3_BUCKET=
# S3_REGION=
MAX_UPLOAD_BYTES=4294967296
USER_QUOTA_BYTES=107374182400
