# Runs the TypeScript sources directly via tsx (no build step). Install with:
#   sudo cp deploy/mobdaw.service /etc/systemd/system/ && sudo systemctl enable --now mobdaw
[Unit]
Description=mobdaw server
After=network.target

[Service]
User=mobdaw
WorkingDirectory=/opt/mobdaw/server
ExecStart=/usr/bin/node --env-file=/etc/mobdaw.env --disable-warning=ExperimentalWarning --import tsx src/main.ts
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
