node_modules
data/
dist/
.env
*.log
engine/target/
client/src/audio/wasm/
.claude/

# Raw tool-run output stays on disk but out of git; only the small summaries are tracked.
docs/*/runs/*/*
!docs/*/runs/*/*.md
!docs/*/runs/*/verify.txt
!docs/*/runs/*/config.yaml
!docs/*/runs/*/best.json
!docs/*/runs/*/run.sh

# Listening eval takes: the audio stays out of git (keep it backed up elsewhere); only the *.chords.txt / *.notes.txt labels are tracked.
docs/listen/*/*.wav
docs/listen/*/*.flac
docs/listen/*/*.mp3
docs/listen/*/*.ogg
docs/listen/*/*.m4a
__pycache__/
